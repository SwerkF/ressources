{
    "name": "Full Stack Development Environment",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:1-bullseye",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "20.11.0"
        },
        "ghcr.io/devcontainers/features/mysql:1": {
            "version": "8.0"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "ms-azuretools.vscode-docker",
                "ms-typescript.js-debug"
            ]
        }
    },
    "forwardPorts": [3000, 5000, 5173],
    "postCreateCommand": "npm install -g npm@latest"
}
